  "sandboxBootstrap": {
    "bundleVersion": 2,
    "note": "Swarm agent sandbox. darkstar-sandbox.exe is first-party: it is compiled from backend/sandbox/windows/DarkstarSandbox.cs with the .NET Framework 4 C# compiler that ships with Windows, and runs each swarm element's programs with a restricted token at low integrity inside a job object (no virtual machine, no driver, no administrator rights). Its qos command also keeps Darkstar's own processes out of Windows power throttling. MinGit, the newest Git for Windows release, is resolved on every run and verified against the SHA-256 digest GitHub publishes.",
    "helperSource": "backend/sandbox/windows/DarkstarSandbox.cs",
    "helper": "backend/bin/sandbox/darkstar-sandbox.exe",
    "gitRoot": "backend/bin/git",
    "allowedHosts": [
      "api.github.com",
      "github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "raw.githubusercontent.com"
    ],
    "git": {
      "repository": "git-for-windows/git",
      "assetPattern": "^MinGit-(\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)-64-bit\\.zip$",
      "license": "GPL-2.0-only",
      "notice": "COPYING"
    }
