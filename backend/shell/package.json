{
  "name": "darkstar",
  "version": "1.2.1",
  "description": "Darkstar Harness - local AI client with an embedded browser",
  "main": "../Darkstar_Core.js",
  "scripts": {
    "bootstrap-python": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../scripts/bootstrap-python.ps1",
    "bootstrap-electron": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../scripts/bootstrap-electron.ps1",
    "bootstrap-llamacpp": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ../scripts/bootstrap-llamacpp.ps1",
    "start": "npm run bootstrap-python && npm run bootstrap-electron && npm run bootstrap-llamacpp && node ../Darkstar_Core.js --darkstar-command=start",
    "build": "npm run bootstrap-python && npm run bootstrap-electron && npm run bootstrap-llamacpp && node ../Darkstar_Core.js --darkstar-command=build",
    "vendor-runtime": "node ../Darkstar_Core.js --darkstar-command=vendor-runtime",
    "test": "node --test ../Dev/Darkstar_Tests.js",
    "quality": "node ../Darkstar_Core.js --darkstar-command=quality",
    "check": "node ../Darkstar_Core.js --darkstar-command=check",
    "offline-audit": "node ../Darkstar_Core.js --darkstar-command=offline-audit",
    "privacy-audit": "node ../Darkstar_Core.js --darkstar-command=privacy-audit",
    "verify": "npm run quality && npm run offline-audit && npm run privacy-audit && npm run runtime-license-audit && npm run check && npm test",
    "manifest": "node ../Darkstar_Core.js --darkstar-command=manifest",
    "runtime-license-audit": "node ../Darkstar_Core.js --darkstar-command=runtime-license-audit"
  },
  "author": "Darkstar Harness contributors",
  "build": {
    "appId": "com.darkstar.chat",
    "productName": "Darkstar Harness",
    "files": [
      "backend/",
      "!backend/Dev/**",
      "!backend/vendor/electron/**",
      "custom_nodes/",
      "agent_assets/",
      "README.md",
      "LICENSE.md"
    ],
    "asarUnpack": [
      "agent_assets/tools/**",
      "agent_assets/skills/**"
    ]
  },
  "license": "Apache-2.0"
}
